{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "App Launcher",
  "version": "../package.json",
  "identifier": "com.tessera.app-launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "App Launcher",
        "width": 980,
        "height": 720,
        "backgroundColor": "#f1e8d7",
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../LICENSE": "legal/LICENSE",
      "../../../THIRD_PARTY_NOTICES.txt": "legal/THIRD_PARTY_NOTICES.txt"
    }
  }
}
